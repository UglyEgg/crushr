{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crushr info truth surface v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "global_flags",
    "preservation_profile",
    "total_entries",
    "structure",
    "verification",
    "strict_extraction_supported"
  ],
  "properties": {
    "format_version": { "type": "string", "minLength": 1 },
    "global_flags": { "type": "string", "minLength": 1 },
    "preservation_profile": { "type": "string", "minLength": 1 },
    "total_entries": { "type": "integer", "minimum": 0 },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extents", "dictionaries", "has_tail_frame"],
      "properties": {
        "extents": { "type": "integer", "minimum": 0 },
        "dictionaries": { "type": "integer", "minimum": 0 },
        "has_tail_frame": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extents_valid", "dictionaries_valid", "tail_frame_valid"],
      "properties": {
        "extents_valid": { "type": "boolean" },
        "dictionaries_valid": { "type": "boolean" },
        "tail_frame_valid": { "type": "boolean" }
      }
    },
    "strict_extraction_supported": { "type": "boolean" }
  }
}
